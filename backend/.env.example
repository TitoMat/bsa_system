# Backend environment template (placeholders only — never commit real values).
# Copy to .env.local for local non-Docker development, or set via the host
# environment / secret store for Docker and production deployments.
#
# The backend reads DATABASE_* / JWT_* / REDIS_* variables through the shared
# canonical DataSource (backend/src/database/data-source.ts) and ConfigModule.

# ── App ──────────────────────────────────────────────────────────────────────
PORT=8181
NODE_ENV=development
APP_ENV=local

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=bsa_local
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME

# ── Auth / secrets ───────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
# Used by InternalApiKeyGuard (x-internal-api-key header).
BSA_INTERNAL_API_KEY=CHANGE_ME
SIGNATURE_ENCRYPTION_KEY=CHANGE_ME

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Bootstrap superadmin (SeedService, first run only) ───────────────────────
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=CHANGE_ME
SUPERADMIN_NAME=Super Admin

# ── Schema synchronization (DEV ONLY, see data-source.ts) ────────────────────
# Production NEVER synchronizes regardless of this flag.
# TYPEORM_SYNCHRONIZE=true
